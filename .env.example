# =============================================================
# apps/admin env — Next.js admin panel
# =============================================================
#
# Single template covering both local-dev and production values.
# Uncomment ONE block per setting.

# ─── Backend API base ────────────────────────────────────────
# LOCAL DEV:
NEXT_PUBLIC_DEV_BASE_URL=http://localhost:3101
# PRODUCTION:
# NEXT_PUBLIC_API_URL=https://v3-api.instafarms.in

# ─── Copilot agent endpoint (admin-agent /agent/jarvis) ──────
# Always loopback — admin-agent is co-located with this Next.js
# app on the same host (locally and on the VM). CopilotRuntime
# does a server-side fetch to this URL; the browser never sees
# it, so there's no need for a public hostname.
AGENT_URL=http://127.0.0.1:8123/agent/jarvis

# ─── Access control for copilot API routes ───────────────────
# Comma-separated host patterns allowed to call /api/copilot* and
# /api/copilotkit. Supports literal hosts and *.subdomain wildcards.
# Defaults (when unset): localhost + 127.0.0.1 + *.instafarms.in.
# COPILOT_ALLOWED_HOSTS=localhost,127.0.0.1,*.instafarms.in

# ─── OpenAI (only used if you add any /api/* route that calls
#     OpenAI directly; agent already has its own key) ─────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Optional override for OpenAI-compatible endpoints. Same semantics as
# admin-agent's OPENAI_BASE_URL — leave blank for api.openai.com.
OPENAI_BASE_URL=

# ─── Where the audit log lives on disk ───────────────────────
# Defaults to ../../packages/admin-agent/logs/audit.log when both
# services are co-located. Override when admin-agent is on a
# different host (mount via NFS, ship to S3, point at a tail).
# AUDIT_LOG_PATH=/var/log/jarvis/audit.log

# ─── Firebase / DB / other secrets ───────────────────────────
# (existing block from before — kept in actual .env, not here)

# Sentry
NEXT_PUBLIC_SENTRY_DSN=

R2_KEY_ID=...              # R2 API token Access Key ID
R2_SECRET_KEY=...          # R2 API token Secret Access Key
R2_ENDPOINT_DEV=https://<accountid>.r2.cloudflarestorage.com
R2_ENDPOINT_PROD=https://<accountid>.r2.cloudflarestorage.com
R2_BUCKET_DEV=...
R2_BUCKET_PROD=...
R2_PUBLIC_URL_DEV=...       # your r2.dev or custom domain, e.g. https://pub-xxxx.r2.dev
R2_PUBLIC_URL_PROD=...
R2_BROWSER_PIN=...          # any PIN you choose, gates destructive actions
