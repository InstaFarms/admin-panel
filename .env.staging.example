# Staging environment template for apps/admin (Next.js).
# Copy to .env.staging on the deploy box and fill in any missing secret values.

# ── API endpoint the admin UI calls ────────────────────────────────────────────
NEXT_PUBLIC_DEV_BASE_URL=http://v3-api.instafarms.in
NEXT_PUBLIC_CLIENT_SITE_URL=https://v3.instafarms.in

# ── Database (read-only ops the Next.js server actions hit directly) ───────────
# DATABASE_URL=

# ── Firebase (NEXT_PUBLIC_* values are baked into the browser bundle) ──────────
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Google Maps ────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Sentry error tracking ──────────────────────────────────────────────────────
# Same DSN for all environments — events are tagged by NODE_ENV (development /
# staging / production) so you can filter per-environment in the Sentry dashboard.
NEXT_PUBLIC_SENTRY_DSN=https://3c67d16c8eb76cca09a5130bb4c658e9@o4510939442577408.ingest.de.sentry.io/4511564653264976
